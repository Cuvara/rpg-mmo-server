# Copy to .env before `make up`. Dev defaults only — never use in any shared env.
# docker compose reads .env from this directory automatically.

# Pinned versions (nakama server tag MUST match the pluginbuilder tag used by
# nakama-plugin.Dockerfile — Go plugins are ABI-locked).
NAKAMA_VERSION=3.40.0

# PostgreSQL (Nakama meta DB)
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432

# PostgreSQL (game state DB — player_states; separate instance from the meta DB)
# Host-run gameserver uses:
#   GAME_DB_URL=postgres://game:localdev@localhost:5433/gamestate?sslmode=disable
POSTGRES_GAME_DB=gamestate
POSTGRES_GAME_USER=game
POSTGRES_GAME_PASSWORD=localdev
POSTGRES_GAME_PORT=5433

# Redis (sessions, server registry, event streams — used by gateway + gameserver)
REDIS_PORT=6379
# Empty = no auth (matches backend/shared/config default REDIS_PASSWORD="").
# Set a value to enable --requirepass; then export the same REDIS_PASSWORD for
# gateway/gameserver.
REDIS_PASSWORD=

# HS256 shared secret. Must equal JWT_SECRET used by gateway + gameserver
# (backend/shared/config/config.go default: dev-secret-change-me).
JWT_SECRET=dev-secret-change-me

# Nakama console (http://localhost:7351)
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=password

# Client server key used in the Nakama client SDK.
NAKAMA_SERVER_KEY=defaultkey

# ---------------------------------------------------------------- monitoring
# `docker compose --profile monitoring up -d` (or `make monitoring-up`) starts
# a single grafana/otel-lgtm container: Grafana + Prometheus + Loki + Tempo +
# Pyroscope + OTel Collector. See docs/MONITORING.md.
OTEL_LGTM_VERSION=0.11.15
GRAFANA_PORT=3000
GRAFANA_USER=admin
# Grafana admin password -> GF_SECURITY_ADMIN_PASSWORD on the lgtm container.
# On deployed environments CD writes this from the GRAFANA_ADMIN_PASSWORD
# environment secret; never leave the dev default in a shared environment.
GRAFANA_ADMIN_PASSWORD=localdev
# The otel-lgtm image enables anonymous access with org role Admin unless
# GF_AUTH_ANONYMOUS_ENABLED is set, so compose pins it off. Set to true only on
# a stack nobody outside the host can reach.
GRAFANA_ANONYMOUS=false
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Host bind addresses for the published monitoring ports. Grafana is reachable
# from anywhere by default (lock it down with a firewall / reverse proxy on a
# VPS — docs/MONITORING.md §Deploying to a VPS); OTLP ingest and the bundled
# Prometheus stay on loopback because nothing off-box pushes to them yet.
GRAFANA_BIND=0.0.0.0
OTLP_BIND=127.0.0.1
PROMETHEUS_BIND=127.0.0.1

# ------------------------------------------------------------ realtime
# `docker compose --profile realtime up -d` runs the gateway and the C# game
# server as containers instead of host processes. This is what CD does when the
# environment sets DEPLOY_MODE=containers (see docs/CICD.md).
#
# Published host ports. The defaults are OFFSET so containers can coexist with
# host-run services during local testing; CD overwrites them with the canonical
# ports (8000 / 9200) so the containers take those over.
GATEWAY_CONTAINER_PORT=8100
GAMESERVER_CONTAINER_PORT=9200
# Prometheus /metrics + /healthz published by each container. Host-run
# processes use the same numbers: gateway :9102 (METRICS_ADDR), C# gameserver
# :9101, Nakama :9100 — all scrape targets in monitoring/prometheus.yaml.
GATEWAY_METRICS_PORT=9102
GAMESERVER_METRICS_PORT=9101
# Listen address of the C# metrics endpoint INSIDE its container. Must be a
# RESOLVABLE NAME: the server cannot bind a wildcard (OpenTelemetry's
# PrometheusHttpListener rejects "http://+:9101/"), so this is the compose
# service name, which is also how Prometheus scrapes it.
GAMESERVER_METRICS_ADDR=gameserver-dotnet:9101
# Image tags the realtime profile runs. CD rewrites these to the commit SHA.
GATEWAY_IMAGE=rpg-mmo/gateway:dev
GAMESERVER_IMAGE=rpg-mmo/gameserver-dotnet:dev
# Registry identity + the address ADVERTISED TO CLIENTS in
# MsgEnterWorldResp.ServerAddr. The C# server does not register itself, so
# scripts/register-gameserver.sh writes this into Redis.
# A listen-style ":9200" is normalized to loopback by clients — fine on a dev
# box, WRONG on a VPS, where it must be <public-host-or-ip>:9200.
GAMESERVER_MAP_ID=map_01
GAMESERVER_ID=gs-dotnet-map_01
GAMESERVER_PUBLIC_ADDR=:9200
