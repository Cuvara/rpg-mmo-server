# Copy to .env before `make up`. Dev defaults only — never use in any shared env.
# docker compose reads .env from this directory automatically.

# Pinned versions (nakama server tag MUST match the pluginbuilder tag used by
# nakama-plugin.Dockerfile — Go plugins are ABI-locked).
NAKAMA_VERSION=3.40.0

# PostgreSQL (Nakama meta DB)
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432

# PostgreSQL (game state DB — player_states; separate instance from the meta DB)
# Host-run gameserver uses:
#   GAME_DB_URL=postgres://game:localdev@localhost:5433/gamestate?sslmode=disable
POSTGRES_GAME_DB=gamestate
POSTGRES_GAME_USER=game
POSTGRES_GAME_PASSWORD=localdev
POSTGRES_GAME_PORT=5433

# Redis (sessions, server registry, event streams — used by gateway + gameserver)
REDIS_PORT=6379
# Empty = no auth (matches backend/shared/config default REDIS_PASSWORD="").
# Set a value to enable --requirepass; then export the same REDIS_PASSWORD for
# gateway/gameserver.
REDIS_PASSWORD=

# HS256 shared secret. Must equal JWT_SECRET used by gateway + gameserver
# (backend/shared/config/config.go default: dev-secret-change-me).
JWT_SECRET=dev-secret-change-me

# Nakama console (http://localhost:7351)
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=password

# Client server key used in the Nakama client SDK.
NAKAMA_SERVER_KEY=defaultkey

# ---------------------------------------------------------------- monitoring
# `docker compose --profile monitoring up -d` (or `make monitoring-up`) starts
# a single grafana/otel-lgtm container: Grafana + Prometheus + Loki + Tempo +
# Pyroscope + OTel Collector. See docs/MONITORING.md.
OTEL_LGTM_VERSION=0.11.15
GRAFANA_PORT=3000
GRAFANA_USER=admin
# Grafana admin password -> GF_SECURITY_ADMIN_PASSWORD on the lgtm container.
# On deployed environments CD writes this from the GRAFANA_ADMIN_PASSWORD
# environment secret; never leave the dev default in a shared environment.
GRAFANA_ADMIN_PASSWORD=localdev
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Host bind addresses for the published monitoring ports. Grafana is reachable
# from anywhere by default (lock it down with a firewall / reverse proxy on a
# VPS — docs/MONITORING.md §Deploying to a VPS); OTLP ingest and the bundled
# Prometheus stay on loopback because nothing off-box pushes to them yet.
GRAFANA_BIND=0.0.0.0
OTLP_BIND=127.0.0.1
PROMETHEUS_BIND=127.0.0.1

# Prometheus port published by the containerised gateway (`--profile realtime`).
# Host-run processes use: gateway :9102 (METRICS_ADDR), C# gameserver :9101,
# Nakama :9100 — all three are scrape targets in monitoring/prometheus.yaml.
GATEWAY_METRICS_PORT=9102
