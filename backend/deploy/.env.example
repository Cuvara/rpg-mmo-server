# Copy to .env before `make up`. Dev defaults only — never use in any shared env.
# docker compose reads .env from this directory automatically.

# Pinned versions (nakama server tag MUST match the pluginbuilder tag used by
# nakama-plugin.Dockerfile — Go plugins are ABI-locked).
NAKAMA_VERSION=3.40.0

# PostgreSQL (Nakama meta DB)
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432

# PostgreSQL (game state DB — player_states; separate instance from the meta DB)
POSTGRES_GAME_DB=gamestate
POSTGRES_GAME_USER=game
POSTGRES_GAME_PASSWORD=localdev
POSTGRES_GAME_PORT=5433

# Game-state DSN for tools that run on the HOST rather than in the compose
# network: `bin/smoketest` (its gamestate_* checks SKIP without this) and
# `gameserver-dotnet --migrate-only`. The gameserver *container* does not read
# this — docker-compose.yml builds its own GAME_DB_URL from the POSTGRES_GAME_*
# values above, pointing at `postgres-game:5432` instead of the published port.
GAME_DB_URL=postgres://game:localdev@localhost:5433/gamestate?sslmode=disable

# Redis (sessions, server registry, event streams — used by gateway + gameserver)
REDIS_PORT=6379
# Empty = no auth (matches backend/shared/config default REDIS_PASSWORD="").
# Set a value to enable --requirepass; then export the same REDIS_PASSWORD for
# gateway/gameserver.
REDIS_PASSWORD=

# HS256 shared secret. Must equal JWT_SECRET used by gateway + gameserver
# (backend/shared/config/config.go default: dev-secret-change-me).
JWT_SECRET=dev-secret-change-me

# HS256 secret the gateway signs join tokens with and every game server verifies
# them with. Must be the SAME value on gateway + all game servers, and MUST NOT
# be reused from JWT_SECRET: a compromised game-server pod must not be able to
# forge client auth tokens. Both binaries refuse to start when this is unset.
# Rotate with a comma-separated list: JOIN_TOKEN_SECRET=new,old
# Production: JOIN_TOKEN_SECRET="$(openssl rand -hex 32)"
JOIN_TOKEN_SECRET=dev-join-secret-change-me

# Nakama console (http://localhost:7351)
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=password

# Client server key used in the Nakama client SDK.
NAKAMA_SERVER_KEY=defaultkey

# ---------------------------------------------------------------- monitoring
# `docker compose --profile monitoring up -d` (or `make monitoring-up`) starts
# a single grafana/otel-lgtm container: Grafana + Prometheus + Loki + Tempo +
# Pyroscope + OTel Collector. See docs/MONITORING.md.
OTEL_LGTM_VERSION=0.11.15
GRAFANA_PORT=3000
GRAFANA_USER=admin
# Grafana admin password -> GF_SECURITY_ADMIN_PASSWORD on the lgtm container.
# On deployed environments CD writes this from the GRAFANA_ADMIN_PASSWORD
# environment secret; never leave the dev default in a shared environment.
GRAFANA_ADMIN_PASSWORD=localdev
# The otel-lgtm image enables anonymous access with org role Admin unless
# GF_AUTH_ANONYMOUS_ENABLED is set, so compose pins it off. Set to true only on
# a stack nobody outside the host can reach.
GRAFANA_ANONYMOUS=false
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Host bind addresses for the published monitoring ports. Grafana is reachable
# from anywhere by default (lock it down with a firewall / reverse proxy on a
# VPS — docs/MONITORING.md §Deploying to a VPS); OTLP ingest and the bundled
# Prometheus stay on loopback because nothing off-box pushes to them yet.
GRAFANA_BIND=0.0.0.0
OTLP_BIND=127.0.0.1
PROMETHEUS_BIND=127.0.0.1

# ------------------------------------------------------------ realtime
# `docker compose --profile realtime up -d` runs the gateway and the C# game
# server as containers instead of host processes. This is what CD does when the
# environment sets DEPLOY_MODE=containers (see docs/CICD.md).
#
# Published host ports. The defaults are OFFSET so containers can coexist with
# host-run services during local testing; CD overwrites them with the canonical
# ports (8000 / 9200) so the containers take those over.
GATEWAY_CONTAINER_PORT=8100
GAMESERVER_CONTAINER_PORT=9200
# Prometheus /metrics + /healthz published by each container. Host-run
# processes use the same numbers: gateway :9102 (METRICS_ADDR), C# gameserver
# :9101, Nakama :9100 — all scrape targets in monitoring/prometheus.yaml.
GATEWAY_METRICS_PORT=9102
GAMESERVER_METRICS_PORT=9101
# Listen address of the C# metrics endpoint INSIDE its container. The wildcard
# is correct: it answers on any Host, so both the in-network scrape
# (gameserver-dotnet:9101) and a host-side probe (127.0.0.1:9101) work.
GAMESERVER_METRICS_ADDR=:9101
# Image tags the realtime profile runs. CD rewrites these to the commit SHA.
GATEWAY_IMAGE=rpg-mmo/gateway:dev
GAMESERVER_IMAGE=rpg-mmo/gameserver-dotnet:dev
# Registry identity + the address ADVERTISED TO CLIENTS in
# MsgEnterWorldResp.ServerAddr. The C# game server publishes this into Redis
# itself on startup and heartbeats it every 5s (TTL 15s); REDIS_ADDR is what
# points it at the registry.
# A listen-style ":9200" is normalized to loopback by clients — fine on a dev
# box, WRONG on a VPS, where it must be <public-host-or-ip>:9200.
GAMESERVER_MAP_ID=map_01
GAMESERVER_ID=gs-dotnet-map_01
GAMESERVER_PUBLIC_ADDR=:9200
# Multi-rate simulation. SIM_CRITICAL_HZ is the BASE tick rate; the other two
# must divide it EXACTLY and must not exceed it, or the game server exits with
# code 2 at startup rather than rounding (so 60/25/5 is refused; 60/15/5,
# 60/20/5, 30/15/5 are fine). Snapshots are broadcast at the WORLD rate, not the
# base rate — SIM_WORLD_HZ is the knob that moves bandwidth per client, and the
# keyframe interval counts snapshots, so it moves with it too.
# See backend/gameserver-dotnet/docs/README.md.
SIM_CRITICAL_HZ=60
SIM_WORLD_HZ=15
SIM_BACKGROUND_HZ=5

# ------------------------------------------------------ Agones (opt-in, off)
# Only relevant when game servers run under Agones in a Kubernetes cluster
# while the gateway stays here in compose. Off by default: with ALLOCATOR=none
# an unserved map is simply an error and no cluster is needed at all.
#
# Turning it on ALSO needs the kubeconfig overlay, or the gateway exits 1 at
# startup instead of running degraded:
#   docker compose -f docker-compose.yml -f docker-compose.agones.yml up -d
# See docs/K3S.md.
ALLOCATOR=none
# The fleet these names must match is agones/fleet-map-dotnet-dev.yaml. The
# gateway's compiled-in defaults still name the RETIRED Go fleets
# (map-servers-dev / dungeon-servers-dev), so leaving these unset points
# allocation at a fleet that does not exist.
ALLOCATOR_NAMESPACE=rpg-realtime
ALLOCATOR_FLEET_MAP=map-servers-dotnet-dev
# No dungeon fleet exists yet (ADR-14 stage 6).
ALLOCATOR_FLEET_DUNGEON=
# What the FLEET's servers listen with — stamped onto the allocated ServerInfo
# and announced to the client before the pod's own registration lands.
ALLOCATOR_TRANSPORT=tcp
# Host path to a kubeconfig the gateway container can use. Its `server:` URL
# must be reachable FROM INSIDE THE CONTAINER (usually host.docker.internal),
# and that host string must be a SAN on the API server's certificate.
# Git-ignored. Never commit a kubeconfig.
KUBECONFIG_HOST=./kubeconfig.local

# Pre-shared AES-256 key for the KCP transport (TRANSPORT_KEY), shared by the
# gateway, the game server and the Agones Secret. UNUSED while the transport is
# TCP — the game server warns that the key is ignored — and carried so that
# enabling KCP is a config change rather than a new secret-distribution problem.
# 64 hex chars are used verbatim; anything else is stretched with HKDF-SHA256.
# Production: TRANSPORT_KEY="$(openssl rand -hex 32)"
TRANSPORT_KEY=
