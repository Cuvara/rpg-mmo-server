# Dockerfile.gameserver-dotnet — Multi-stage NativeAOT build
#
# Build context: backend/
#   docker build -f deploy/docker/Dockerfile.gameserver-dotnet \
#     --build-arg GIT_REVISION="$(git rev-parse HEAD)" \
#     -t rpg-mmo/gameserver-dotnet:dev .
#
# The resulting image is ~30-40 MB (Alpine + single static binary).
#
# PASS GIT_REVISION. A mutable tag like `:dev` says nothing about what is inside
# it, and `imagePullPolicy: IfNotPresent` on a shared image store will happily
# run last week's build while every manifest and ADR describes this week's code.
# That is not hypothetical: the `:dev` in the local store on 2026-08-17 was built
# 5.4 hours before the commit that added the real Agones SDK, so a fleet deployed
# from it would have come up green running the no-op SDK. The label below turns
# "is this image the code under test?" into a question a command can answer:
#
#   docker image inspect rpg-mmo/gameserver-dotnet:dev \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# An image built without the arg reports "unknown", which is itself the answer.

# ---------------------------------------------------------------------------
# Stage 1: Build (SDK + native toolchain for AOT compilation)
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build

# NativeAOT on Alpine requires clang, linker, and zlib headers.
RUN apk add --no-cache clang build-base zlib-dev

WORKDIR /src

# -- Restore layer (changes rarely, cached aggressively) --------------------
COPY gameserver-dotnet/Shared.GameLogic/Shared.GameLogic.csproj Shared.GameLogic/
COPY gameserver-dotnet/GameServer/GameServer.csproj GameServer/

# Restore NuGet packages (cached until a .csproj changes).
RUN dotnet restore GameServer/GameServer.csproj

# -- Source layer ------------------------------------------------------------
COPY gameserver-dotnet/Shared.GameLogic/ Shared.GameLogic/
COPY gameserver-dotnet/GameServer/ GameServer/

# -- Publish NativeAOT (single file, no IL, no JIT) -------------------------
# NativeAOT on Alpine requires -r linux-musl-x64. We let publish run its own
# RID-specific restore pass (fast — packages already cached from the layer above).
RUN dotnet publish GameServer/GameServer.csproj \
      -c Release \
      -r linux-musl-x64 \
      -o /app

# ---------------------------------------------------------------------------
# Stage 2: Runtime (minimal Alpine image — no SDK, no IL runtime)
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-alpine-extra AS runtime

# Non-root user matching distroless UID convention.
RUN addgroup -g 65532 -S nonroot && \
    adduser -u 65532 -S nonroot -G nonroot

WORKDIR /app
COPY --from=build /app .

# Provenance. Declared AFTER the copy so a rebuild at a new revision does not
# invalidate the expensive AOT layers above it.
ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.title="rpg-mmo gameserver (.NET 10 NativeAOT)" \
      org.opencontainers.image.source="https://github.com/cuvara/rpg-mmo-server"

USER 65532:65532

# Game traffic (TCP for framed messages, UDP reserved for future KCP).
EXPOSE 9000/tcp 9000/udp
# Observability: /metrics + /healthz (METRICS_ADDR, default :9101).
EXPOSE 9101/tcp

ENTRYPOINT ["./GameServer"]
