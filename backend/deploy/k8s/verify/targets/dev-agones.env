# Target: the dev stack as it stands today -- data tier and gateway in docker
# compose, game servers in k3d under Agones. This is the "before" side of the
# k3s/Agones move: the same suite must pass here and on the k8s stack.
#
# Secrets are NOT stored here. Export JWT_SECRET (or VERIFY_JWT_SECRET) before
# running; the value the running gateway uses can be read with:
#   docker inspect rpg-gateway --format '{{range .Config.Env}}{{println .}}{{end}}' | grep '^JWT_SECRET='
# (`docker exec <c> printenv` does NOT work on the distroless gateway image --
#  it returns the exec error text, which reads exactly like a value.)

VERIFY_TARGET_NAME="dev-agones (compose data tier + k3d Agones fleet)"

# --- layer 1: cluster ---
KUBE_CONTEXT="k3d-rpg-dev"
VERIFY_NAMESPACES="rpg-realtime agones-system"
VERIFY_PVCS=""                       # data tier is in compose today: no PVCs -> visible SKIP
VERIFY_FLEET="rpg-realtime/map-servers-dotnet-dev"
VERIFY_FLEET_MIN_REPLICAS=1
VERIFY_SECRETS="rpg-realtime/rpg-realtime-secrets"

# --- layer 2: data tier (exec prefixes, so the same checks work in-cluster) ---
VERIFY_PG_META_EXEC="docker exec rpg-postgres"
VERIFY_PG_META_USER="nakama"
VERIFY_PG_META_DB="nakama"
VERIFY_PG_GAME_EXEC="docker exec rpg-postgres-game"
VERIFY_PG_GAME_USER="game"
VERIFY_PG_GAME_DB="gamestate"
VERIFY_GAME_MIGRATION=1
VERIFY_REDIS_EXEC="docker exec rpg-redis"
VERIFY_REDIS_AUTH=""                 # empty = no AUTH, matching REDIS_PASSWORD=""
VERIFY_NAKAMA_URL="http://127.0.0.1:7350"
VERIFY_NAKAMA_SERVER_KEY="defaultkey"

# --- layer 3: registry ---
VERIFY_GATEWAY_ADDR="127.0.0.1:8000"
VERIFY_MAP_ID="map_01"
# k3d publishes the game-server node ports onto the host, so the address a pod
# advertises is loopback-from-the-host and correct HERE and only here. On the
# k8s target leave this at 0 so a loopback address fails.
VERIFY_ADDR_ALLOW_LOOPBACK=1

# --- layer 4: flow ---
# Empty = build from source (see targets/k8s-dev.env for the rationale).
VERIFY_SMOKETEST_BIN="${VERIFY_SMOKETEST_BIN:-}"
VERIFY_GAME_DB_URL="postgres://game:localdev@127.0.0.1:5433/gamestate?sslmode=disable"
VERIFY_HOLD_TTL="30s"

# --- layer 5: Unity client ---
VERIFY_UNITY_PROJECT='E:\SecretProject\IndieRPGMMOAdventure'
VERIFY_UNITY_GATEWAY_HOST="127.0.0.1"
VERIFY_UNITY_GATEWAY_PORT="8000"
VERIFY_UNITY_NAKAMA_HOST="127.0.0.1"
VERIFY_UNITY_NAKAMA_PORT="7350"
VERIFY_UNITY_MIN_TESTS=0             # set once the expected PlayMode count is stable
# VERIFY_UNITY_RESULTS=/abs/path/playmode.xml   # or pass --unity-results

# --- layer 6: refusals ---
VERIFY_GATEWAY_IMAGE="${VERIFY_GATEWAY_IMAGE:-$(docker inspect rpg-gateway --format '{{.Config.Image}}' 2>/dev/null)}"
VERIFY_GATEWAY_LOG_CMD="docker logs --since 60m rpg-gateway"
VERIFY_ALLOW_ALLOCATION=0            # see refusal.unknown_map: costs a GameServer

# rpg-realtime-secrets carries redis-password, which is empty ON PURPOSE in dev
# (REDIS_PASSWORD="" -> no AUTH). Named explicitly so the exemption is one key
# on one secret, printed as "empty-by-config" in the output, rather than a
# blanket "empty is fine".
VERIFY_SECRETS_ALLOW_EMPTY="rpg-realtime/rpg-realtime-secrets:redis-password"
