# Target: the all-in-cluster stack -- data tier, Nakama and gateway as k8s
# workloads alongside the Agones fleet. Fill the placeholders as the move lands;
# every value here is deliberately explicit rather than defaulted, so an
# unfinished migration shows up as a failing check rather than a silent default.

VERIFY_TARGET_NAME="k8s-dev (full stack in-cluster)"

KUBE_CONTEXT="k3d-rpg-dev"
VERIFY_NAMESPACES="rpg-realtime rpg-data agones-system"
VERIFY_PVCS="rpg-data/postgres-meta rpg-data/postgres-game rpg-data/redis"
VERIFY_FLEET="rpg-realtime/map-servers-dotnet-dev"
VERIFY_FLEET_MIN_REPLICAS=1
VERIFY_SECRETS="rpg-realtime/rpg-realtime-secrets rpg-data/rpg-data-secrets"

K="kubectl --context ${KUBE_CONTEXT}"
VERIFY_PG_META_EXEC="$K exec -n rpg-data statefulset/postgres-meta --"
VERIFY_PG_META_USER="nakama"
VERIFY_PG_META_DB="nakama"
VERIFY_PG_GAME_EXEC="$K exec -n rpg-data statefulset/postgres-game --"
VERIFY_PG_GAME_USER="game"
VERIFY_PG_GAME_DB="gamestate"
VERIFY_GAME_MIGRATION=1
VERIFY_REDIS_EXEC="$K exec -n rpg-data statefulset/redis --"
VERIFY_REDIS_AUTH=""

# Reachable from where the suite runs: a NodePort/ingress, or a port-forward
# started by the operator before the run.
VERIFY_NAKAMA_URL="http://127.0.0.1:7350"
VERIFY_NAKAMA_SERVER_KEY="defaultkey"
VERIFY_GATEWAY_ADDR="127.0.0.1:8000"
VERIFY_MAP_ID="map_01"

# In-cluster the advertised address must be the pod/node address. A loopback
# address here means the game server is advertising something only its own node
# can dial -- which is the defect, not a dev convenience.
VERIFY_ADDR_ALLOW_LOOPBACK=0

VERIFY_SMOKETEST_BIN="${VERIFY_SMOKETEST_BIN:-/tmp/smoketest}"
VERIFY_GAME_DB_URL=""                # set to a DSN reachable from the runner, or the check SKIPs loudly
VERIFY_HOLD_TTL="30s"

VERIFY_UNITY_PROJECT='E:\SecretProject\IndieRPGMMOAdventure'
VERIFY_UNITY_GATEWAY_HOST="127.0.0.1"
VERIFY_UNITY_GATEWAY_PORT="8000"
VERIFY_UNITY_NAKAMA_HOST="127.0.0.1"
VERIFY_UNITY_NAKAMA_PORT="7350"
VERIFY_UNITY_MIN_TESTS=0

VERIFY_GATEWAY_IMAGE=""              # e.g. rpg-mmo/gateway:<sha>
VERIFY_GATEWAY_LOG_CMD="$K logs -n rpg-realtime deploy/gateway --since=60m"
VERIFY_ALLOW_ALLOCATION=0
