# Target: dev running ENTIRELY on k3s/Agones -- data tier, Nakama, gateway and
# the map fleet all as in-cluster workloads. This is the "after" side of the
# k3s/Agones move; dev-agones.env is the "before". Nothing here may reference a
# docker compose container or `host.k3d.internal`: if it does, the migration is
# not done.
#
# Secrets are NOT stored here. Export JWT_SECRET (or VERIFY_JWT_SECRET) before
# running; the value the running stack uses can be read with:
#   kubectl --context k3d-rpg-dev get secret -n rpg-k8s-realtime rpg-app-secrets \
#     -o jsonpath='{.data.jwt-secret}' | base64 -d

VERIFY_TARGET_NAME="k8s-dev (full stack in-cluster)"

# --- layer 1: cluster ---
KUBE_CONTEXT="k3d-rpg-dev"
# The namespaces the manifests under backend/deploy/k8s/{data,app} actually
# declare. agones-system is included because the fleet cannot be healthy
# without a healthy controller, and its restarts are worth catching here.
VERIFY_NAMESPACES="rpg-k8s-realtime rpg-k8s-data agones-system"
# StatefulSet volumeClaimTemplates -> "data-<sts>-<ordinal>".
VERIFY_PVCS="rpg-k8s-data/data-postgres-meta-0 rpg-k8s-data/data-postgres-game-0 rpg-k8s-data/data-redis-0"
VERIFY_FLEET="rpg-k8s-realtime/map-servers-dotnet-k8s"
# replicas is 1 and MUST stay 1 while every replica carries the same
# GAMESERVER_MAP_ID: the C# server self-registers at STARTUP, not on
# allocation, so a second replica would be a second live server for map_01 --
# the ADR-2 split world. Measured on k3d 2026-08-18: scaling 1 -> 2 put a
# second member into servers:map:map_01 5.38s later, with no allocation
# involved.
#
# The consequence is that a fleet whose one pod is Allocated reports ready=0.
# check_fleet_replicas no longer WARNs about that here: on a fleet that pins a
# fleet-wide map id it is the designed steady state, and it passes saying so.
# check_no_single_map_autoscaler (cluster.autoscaler) FAILS if anyone adds a
# FleetAutoscaler to make ready=0 go away -- see ADR-18.
VERIFY_FLEET_MIN_REPLICAS=1
VERIFY_SECRETS="rpg-k8s-realtime/rpg-app-secrets rpg-k8s-data/nakama rpg-k8s-data/postgres-meta rpg-k8s-data/postgres-game"
# cluster.restarts window, in seconds. This cluster is a k3d node inside WSL2 on
# a developer box: when that box or Docker Desktop restarts, EVERY container in
# every namespace is terminated with exit 255 and restarted, and restartCount is
# cumulative for the life of the pod. A window-less check therefore fails every
# deploy from then until someone deletes every pod, which is a check measuring
# the host's uptime rather than the deployment. 1800s covers a deploy plus its
# verification with room to spare; older restarts are still WARNed and named.
VERIFY_RESTART_WINDOW=1800

# --- layer 2: data tier (exec prefixes -- in-cluster, no docker exec) ---
K="kubectl --context ${KUBE_CONTEXT}"
VERIFY_PG_META_EXEC="$K exec -n rpg-k8s-data statefulset/postgres-meta --"
VERIFY_PG_META_USER="nakama"
VERIFY_PG_META_DB="nakama"
VERIFY_PG_GAME_EXEC="$K exec -n rpg-k8s-data statefulset/postgres-game --"
VERIFY_PG_GAME_USER="game"
VERIFY_PG_GAME_DB="gamestate"
VERIFY_GAME_MIGRATION=1
VERIFY_REDIS_EXEC="$K exec -n rpg-k8s-data statefulset/redis --"
VERIFY_REDIS_AUTH=""                 # empty = no AUTH, matching redis-password=""

# PUBLISHED ports, not port-forwards, and deliberately NOT 8000/7350.
#
# Two reasons. First, k3d's serverlb publishes only 7000-7100 and 6550, so a
# NodePort in the default 30000-32767 range is allocated and unreachable; the
# manifests use hostPort 7000/7001 out of the published range instead, with the
# Agones controller pinned to MIN_PORT=7010 so the allocator cannot collide.
#
# Second, and this is the one that silently invalidates a whole run: 8000 and
# 7350 are the COMPOSE dev stack's ports. If that stack is up, a suite pointed
# at them goes green having tested the deployment this one replaces. Using
# ports only the k8s stack can own removes the ambiguity, and
# registry.stack_identity / flow.stack_identity assert the attribution rather
# than trusting it.
VERIFY_NAKAMA_URL="http://127.0.0.1:7001"
VERIFY_NAKAMA_SERVER_KEY="defaultkey"
VERIFY_GATEWAY_ADDR="127.0.0.1:7000"
VERIFY_MAP_ID="map_01"

# k3d publishes the Agones host-port range 7000-7100 straight onto this box, so
# the address a GameServer advertises is loopback-from-the-host and is the ONLY
# form a client here can dial: the node address (172.20.0.3) is on the k3d
# docker network and is NOT reachable from WSL2 or from Windows -- measured,
# not assumed. Loopback is therefore correct on k3d and stays wrong on a real
# multi-node cluster, where this must go back to 0. registry.addr_dialable is
# what keeps this honest: it actually opens the advertised address.
VERIFY_ADDR_ALLOW_LOOPBACK=1

# --- layer 4: flow ---
# Prebuilt binaries, when the caller has them. CI exports both from the
# deployment bundle (dist/bin/smoketest, dist/bin/verify-probe) because the
# deploy runner is a self-hosted box with no Go toolchain on PATH -- see
# backend/deploy/docs/CICD.md. Left EMPTY here on purpose: unset means "build
# from source", which is what an operator with go installed wants, and a
# hardcoded scratch path in a checked-in file would be wrong on every other box.
VERIFY_SMOKETEST_BIN="${VERIFY_SMOKETEST_BIN:-}"
VERIFY_PROBE_BIN="${VERIFY_PROBE_BIN:-}"
# postgres-game is a headless ClusterIP; dev-up.sh port-forwards it to 15433 so
# the persistence assertions RUN rather than degrading to a warn.
VERIFY_GAME_DB_URL="postgres://game:localdev@127.0.0.1:15433/gamestate?sslmode=disable"
VERIFY_HOLD_TTL="30s"

# --- layer 5: Unity client ---
VERIFY_UNITY_PROJECT='E:\SecretProject\IndieRPGMMOAdventure'
VERIFY_UNITY_GATEWAY_HOST="127.0.0.1"
VERIFY_UNITY_GATEWAY_PORT="7000"
VERIFY_UNITY_NAKAMA_HOST="127.0.0.1"
VERIFY_UNITY_NAKAMA_PORT="7001"
VERIFY_UNITY_MIN_TESTS=30
# VERIFY_UNITY_RESULTS=/abs/path/playmode.xml   # or pass --unity-results

# --- layer 6: refusals ---
VERIFY_GATEWAY_IMAGE="${VERIFY_GATEWAY_IMAGE:-$($K get deploy gateway -n rpg-k8s-realtime -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null)}"
VERIFY_GATEWAY_LOG_CMD="$K logs -n rpg-k8s-realtime deploy/gateway --since=60m"
VERIFY_ALLOW_ALLOCATION=0            # see refusal.unknown_map: costs a GameServer

# redis-password and transport-key are empty ON PURPOSE in dev (no AUTH, no
# transport encryption). Named per key so the exemption is explicit rather than
# a blanket "empty is fine".
VERIFY_SECRETS_ALLOW_EMPTY="rpg-k8s-realtime/rpg-app-secrets:redis-password,transport-key"
