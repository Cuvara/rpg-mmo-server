// Grafana Alloy: ships the container logs of THIS compose project to the Loki
// bundled in the `lgtm` service (grafana/otel-lgtm). See docs/MONITORING.md.
//
// Collection path: Docker API through the read-only `docker-socket-proxy`
// service, never the socket itself. Alloy mounts no Docker socket.
//
// Environment (set by docker-compose.yml, written into deploy/.env by CD):
//   COMPOSE_PROJECT_NAME  only containers of this compose project are shipped
//                         (three stacks can share one Docker daemon)
//   DEPLOY_ENVIRONMENT    value of the `env` label (environments.tsv identity)
//
// Labels on every stream, and NO others (enforced by the label_keep stage):
//   env, service, level
// plus, on game server streams only:
//   game, server_id
// Never add a label built from a container id, user id, connection id or any
// other value that is unbounded: every distinct label set is a Loki stream.

discovery.docker "containers" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "10s"

  // Narrow the listing at the source ...
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // ... and keep the rule below as the one that is actually relied on: a
  // relabel `keep` is anchored, and it is what the offline config test checks.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("COMPOSE_PROJECT_NAME")
    action        = "keep"
  }

  rule {
    target_label = "env"
    replacement  = sys.env("DEPLOY_ENVIRONMENT")
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Game servers carry the compose labels cuvara.log.game and
  // cuvara.log.server_id (docker-compose.yml, docker-compose.override.yml).
  // Every other container lacks them, the source is empty, and an empty
  // replacement removes the label: a stream without `game` is stack-wide.
  rule {
    source_labels = ["__meta_docker_container_label_cuvara_log_game"]
    target_label  = "game"
  }

  rule {
    source_labels = ["__meta_docker_container_label_cuvara_log_server_id"]
    target_label  = "server_id"
  }
}

loki.source.docker "containers" {
  host             = "tcp://docker-socket-proxy:2375"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.level.receiver]
  refresh_interval = "10s"
}

loki.process "level" {
  forward_to = [loki.write.lgtm.receiver]

  // Every stream starts as `unknown`: a plain or unparseable line keeps it.
  stage.static_labels {
    values = {
      level = "unknown",
    }
  }

  // Only a line that looks like a JSON object is parsed. The line body is
  // never rewritten: stages here only read it and set labels.
  //
  // Sources of the field, all named `level`:
  //   gateway    Go slog       INFO WARN ERROR DEBUG
  //   Nakama     zap           info warn error debug dpanic panic fatal
  //   gameserver JSON logger   Information Warning Critical ...
  stage.match {
    selector = `{service=~".+"} |~ "^\\s*\\{"`

    stage.json {
      expressions = {
        level = "level",
      }
    }

    // One spelling per level. Anything else (a number, a custom word) becomes
    // `unknown` instead of minting a stream per distinct value.
    stage.template {
      source   = "level"
      template = `{{ if .level }}{{ $l := ToLower (printf "%v" .level) }}{{ if or (eq $l "trace") (eq $l "trc") }}trace{{ else if or (eq $l "debug") (eq $l "dbg") }}debug{{ else if or (eq $l "info") (eq $l "information") (eq $l "inf") }}info{{ else if or (eq $l "warn") (eq $l "warning") (eq $l "wrn") }}warn{{ else if or (eq $l "error") (eq $l "err") }}error{{ else if or (eq $l "fatal") (eq $l "critical") (eq $l "crit") (eq $l "panic") (eq $l "dpanic") }}fatal{{ else }}unknown{{ end }}{{ else }}unknown{{ end }}`
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  // The contract: exactly these labels reach Loki, whatever discovery added.
  stage.label_keep {
    values = ["env", "service", "level", "game", "server_id"]
  }
}

loki.write "lgtm" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}
