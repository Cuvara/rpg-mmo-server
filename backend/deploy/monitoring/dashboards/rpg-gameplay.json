{
  "uid": "rpg-gameplay",
  "title": "RPG Gameplay",
  "tags": ["rpg", "gameplay"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Game server tick duration p99",
      "description": "histogram_quantile over gameserver_tick_duration_seconds. Budget: 10-15Hz tick => p99 must stay well under 66-100ms.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.066 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, map_id) (rate(gameserver_tick_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{map_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Players online",
      "description": "gameserver_players_online — entities simulated per map server.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (map_id) (gameserver_players_online)",
          "legendFormat": "{{map_id}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gameserver_players_online)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Gateway connections active",
      "description": "gateway_connections_active — client sockets held by each gateway instance.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (gateway_connections_active)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway auth failure rate",
      "description": "Share of failing MsgAuth attempts. A sustained climb means bad/expired JWTs or a secret mismatch with Nakama.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gateway_auth_total{result=\"fail\"}[5m])) / clamp_min(sum(rate(gateway_auth_total[5m])), 0.0001)",
          "legendFormat": "auth fail ratio"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gateway_enter_world_total{result=\"fail\"}[5m])) / clamp_min(sum(rate(gateway_enter_world_total[5m])), 0.0001)",
          "legendFormat": "enter_world fail ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "State save errors",
      "description": "gameserver_save_errors_total — async player-state persistence failures. Non-zero means player progress is at risk.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gameserver_save_errors_total[5m]))",
          "legendFormat": "save errors/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gateway_allocations_total{result=\"fail\"}[5m]))",
          "legendFormat": "allocation failures/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "1 = the process is exporting metrics. gameserver stays 0 until the C# server runs with metrics enabled.",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (job) (up)",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    }
  ]
}
