{
  "uid": "rpg-overview",
  "title": "RPG MMO — Overview",
  "description": "Single-pane view of the local dev stack: scrape health, gameserver tick budget, gateway session flow, persistence and Nakama meta services. Provisioned from backend/deploy/monitoring/grafana/dashboards/rpg-overview.json — edit the file, not the UI.",
  "tags": ["rpg-mmo", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "rpg-prometheus" },
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Scrape targets (up)",
      "description": "One row per Prometheus target. gateway/gameserver read DOWN until those processes are running with their metrics listeners bound (:9102 / :9101).",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "cluster": true },
            "renameByName": {
              "Value": "up",
              "job": "Job",
              "instance": "Instance",
              "component": "Component",
              "env": "Env"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "up" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players online",
      "description": "gameserver_players_online summed across maps — entities currently simulated, i.e. realtime CCU.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(gameserver_players_online)", "legendFormat": "players" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Gateway connections",
      "description": "gateway_connections_active — live TCP/KCP sessions held by the gateway. Diverging far from players online means sessions are stuck pre-EnterWorld.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(gateway_connections_active)", "legendFormat": "connections" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Snapshots / sec",
      "description": "rate(gameserver_snapshots_sent_total). At 15Hz this should track players_online x 15 once AOI has anyone to broadcast to.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(rate(gameserver_snapshots_sent_total[$__rate_interval]))", "legendFormat": "snapshots/s" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Nakama presences",
      "description": "nakama_presences — meta-channel CCU (socket sessions on Nakama), independent of the realtime path.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(nakama_presences)", "legendFormat": "presences" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Tick duration p50 / p95 / p99",
      "description": "histogram_quantile over gameserver_tick_duration_seconds_bucket. The dashed 66ms threshold is the full 15Hz tick budget — p99 above it means the sim loop is slipping and the TickBudgetExceeded alert will fire after 5m.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(gameserver_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(gameserver_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(gameserver_tick_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.066 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Players online per map",
      "description": "gameserver_players_online broken out by map_id — shows load distribution and which map a spike came from.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "gameserver_players_online", "legendFormat": "{{map_id}}" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Gateway: auth & enter_world rate",
      "description": "Connection-flow throughput split by result. A rising fail line without a matching ok line is the HighAuthFailureRate signature — usually JWT secret drift between Nakama and the gateway.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(gateway_auth_total[$__rate_interval]))", "legendFormat": "auth {{result}}" },
        { "refId": "B", "expr": "sum by (result) (rate(gateway_enter_world_total[$__rate_interval]))", "legendFormat": "enter_world {{result}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*fail.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Gateway: active connections",
      "description": "gateway_connections_active over time. A sawtooth that never drains points at sessions not being reaped on disconnect.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "refId": "A", "expr": "gateway_connections_active", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Snapshot broadcast rate",
      "description": "rate(gameserver_snapshots_sent_total) per instance — the outbound half of the realtime loop.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [{ "refId": "A", "expr": "sum by (instance) (rate(gameserver_snapshots_sent_total[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Persistence: saves vs save errors",
      "description": "Async batch persistence (every 30-60s, off the tick loop), split by the status label of gameserver_player_saves_total. ANY sustained error rate means player state is being dropped — SaveErrors alert fires after 5m.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(gameserver_player_saves_total[$__rate_interval]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "ok" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "Nakama: request rate by API",
      "description": "rate(nakama_*_count) — meta-channel traffic. Metric names come from Nakama's own Prometheus exporter on :9100 (nakama_Rpc_count, nakama_AuthenticateDevice_count, ...).",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "targets": [
        { "refId": "A", "expr": "rate(nakama_Rpc_count[$__rate_interval])", "legendFormat": "Rpc" },
        { "refId": "B", "expr": "rate(nakama_AuthenticateDevice_count[$__rate_interval])", "legendFormat": "AuthenticateDevice" },
        { "refId": "C", "expr": "rate(nakama_overall_request_count[$__rate_interval])", "legendFormat": "overall" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Nakama: mean API latency",
      "description": "nakama_overall_latency_ms_sum / _count — Nakama exports latency as a summary in MILLISECONDS, so this is a ratio-of-rates, not a histogram_quantile. True percentiles are not available from this exporter.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nakama_overall_latency_ms_sum[$__rate_interval]) / clamp_min(rate(nakama_overall_latency_ms_count[$__rate_interval]), 0.001)",
          "legendFormat": "overall mean"
        },
        {
          "refId": "B",
          "expr": "rate(nakama_Rpc_latency_ms_sum[$__rate_interval]) / clamp_min(rate(nakama_Rpc_latency_ms_count[$__rate_interval]), 0.001)",
          "legendFormat": "Rpc mean"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Nakama: PostgreSQL connection pool",
      "description": "nakama_db_in_use_conns vs nakama_db_max_open_conns. in_use pinned at max = pool exhaustion; queries queue and every meta RPC gets slow.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "targets": [
        { "refId": "A", "expr": "nakama_db_in_use_conns", "legendFormat": "in use" },
        { "refId": "B", "expr": "nakama_db_idle_conns", "legendFormat": "idle" },
        { "refId": "C", "expr": "nakama_db_max_open_conns", "legendFormat": "max open" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 50,
      "type": "row",
      "title": "Detail",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "panels": []
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "World: entities & reconnect holds",
      "description": "gameserver_entities is everything simulated (players + NPCs) — the real driver of tick cost, since AOI is O(n²) in the MVP. gameserver_reconnect_holds counts disconnected players whose entity is still parked (30s map / 60s dungeon); a growing floor means holds are not expiring.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "sum(gameserver_entities)", "legendFormat": "entities" },
        { "refId": "B", "expr": "sum(gameserver_reconnect_holds)", "legendFormat": "reconnect holds" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "Inputs processed & events published",
      "description": "rate(gameserver_tick_processed_inputs_total) is the inbound half of the realtime loop — pair it with the snapshot rate to see both directions. Events are broken out by type.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(gameserver_tick_processed_inputs_total[$__rate_interval]))", "legendFormat": "inputs/s" },
        { "refId": "B", "expr": "sum by (type) (rate(gameserver_events_published_total[$__rate_interval]))", "legendFormat": "event {{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Snapshot bandwidth",
      "description": "rate(gameserver_snapshot_bytes_total) — outbound bytes/sec. The number that decides whether mobile clients survive; watch it against snapshots/sec to catch snapshots growing fatter rather than more frequent.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(gameserver_snapshot_bytes_total[$__rate_interval]))", "legendFormat": "snapshot bytes/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 54,
      "type": "timeseries",
      "title": "Gateway: allocations & relayed events",
      "description": "gateway_allocations_total{result} is server-registry/Agones allocation outcomes — failures here mean EnterWorld cannot place a player even though auth succeeded. gateway_relay_events_total is cross-server event fan-out.",
      "datasource": { "type": "prometheus", "uid": "rpg-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(gateway_allocations_total[$__rate_interval]))", "legendFormat": "alloc {{result}}" },
        { "refId": "B", "expr": "sum(rate(gateway_relay_events_total[$__rate_interval]))", "legendFormat": "relayed events" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*fail.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
