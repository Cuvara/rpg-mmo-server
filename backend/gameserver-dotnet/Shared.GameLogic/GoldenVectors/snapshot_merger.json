      "expectedTick": 11,
      "expectedAckTick": 5,
      "expectedKeyframes": 1,
      "expectedDeltas": 1,
      "expectedEntityIds": ["p1"],
      "expectedCount": 1,
      "expectedEntityState": {"id": "p1", "hp": 100, "x": "0x41A00000", "y": "0x41A00000", "speed": "0x40A00000", "facingBrad": 16385, "action": 2}
    },
