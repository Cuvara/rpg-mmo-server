<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.*" />
    <!-- Entity storage (ADR-10). Arch is an archetype/chunk ECS and is the ONLY
         entity store on the server; it replaced the hand-rolled GameWorld.
         AOT note (ADR-11): Arch.Core.Chunk allocates its backing arrays with
         System.Array.CreateInstance(Type, int), so every component type needs its
         T[] statically constructed or the NativeAOT binary throws
         NotSupportedException on the first archetype creation. World/ArchAotHints.cs
         does that; ArchAotHintTests is the guard that keeps the list complete.
         CommandBuffer is NOT used - it is broken under AOT (ADR-11). -->
    <PackageReference Include="Arch" Version="2.1.0-beta" />
    <!-- Transitive via Arch, and the one dependency here that is NOT AOT-clean:
         the publish reports 37 IL2026/IL3050 diagnostics against it. Audited
         2026-08-11; see docs/DESIGN.md "Collections.Pooled AOT warnings".

         All 37 are in ONE type, Collections.Pooled.PooledEnumerableJsonConverter,
         a JsonConverterFactory. PooledList/Set/Queue/Stack/Collection/
         ObservableCollection each carry [JsonConverter(typeof(...))], and that
         attribute alone roots the converter, so ILC compiles it in (69 method
         bodies in the map file) and analyses it. The warnings are caused by the
         attribute, not by any call site.

         Unreachable here, on four independently checked facts:
           1. A JsonConverterFactory runs only when System.Text.Json builds a
              JsonTypeInfo for an annotated type, which only the REFLECTION-based
              resolver does.
           2. This assembly never uses that resolver - all three JsonSerializer
              call sites pass a source-generated JsonTypeInfo. Enforced by
              GameServer.Tests/Aot/JsonReflectionGuardTests.cs, which scans this
              assembly's metadata and fails on any reflection-based overload.
           3. Arch has ZERO System.Text.Json member references - it uses the
              Pooled collections as storage and never serialises them.
           4. Collections.Pooled has no ModuleInitializer and no <Module> cctor,
              so it never registers these converters globally.

         Trigger, if it ever became reachable: code that (de)serialises a Pooled
         collection - directly or as a member of another type - through a
         reflection-based JsonSerializer overload. CreateConverter then calls
         Type.MakeGenericType and the instantiation may not exist in the binary.
         Unlike the Arch hint bug this is NOT a rare-path hazard: no such code
         exists, and adding it would fail the guard test at (2) first.

         NOT suppressed. Do not add NoWarn - the summary IL3053/IL2104 lines are
         the standing reminder that this package is on a -preview version whose
         newest target is netcoreapp3.0. Re-run the audit on any Arch upgrade. -->
    <!-- Wire protocol. Generated (not reflection-based) serializers, so the
         NativeAOT publish stays warning-free; see shared/proto/wire.proto. -->
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
    <!-- Npgsql 10.x is trim/NativeAOT-annotated; PostgresPlayerStore uses raw
         commands + typed parameters only (no ORM, no reflection mapping). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Server self-registration into the Redis registry the Go gateway reads.
         3.x ships a net10.0 target and is trim/NativeAOT-clean for the surface we
         use (raw commands + a Lua script, no reflection-based object mapping,
         no profiling/tie-breaker features). The `publish` CI job is the gate. -->
    <PackageReference Include="StackExchange.Redis" Version="3.1.11" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.HttpListener" Version="1.17.0-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.GameLogic\Shared.GameLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project assert on internal helpers (e.g.
         MetricsEndpoint.ParseAddr) without widening the public surface. -->
    <InternalsVisibleTo Include="GameServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Numbered schema migrations, embedded so the binary is self-contained and
         the migrate-only mode needs no files on disk. Resource names become
         GameServer.Persistence.Migrations.<file>.sql; Migrator reads them via
         GetManifestResourceStream, which is NativeAOT-safe. -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>


  <ItemGroup>
    <!-- The generated wire.proto types ARE the game server's message types.
         Imported as explicit aliases rather than a whole-namespace using so that
         RpgMmo.Wire.V1.Envelope (the protobuf message) never collides with
         GameServer.Net.Envelope (the framing envelope that carries encoding
         metadata) - they are different things with the same name. -->
    <Using Include="RpgMmo.Wire.V1.MsgType" Alias="MsgType" />
    <Using Include="RpgMmo.Wire.V1.JoinTokenRequest" Alias="JoinTokenRequest" />
    <Using Include="RpgMmo.Wire.V1.JoinTokenResponse" Alias="JoinTokenResponse" />
    <Using Include="RpgMmo.Wire.V1.InputMessage" Alias="InputMessage" />
    <Using Include="RpgMmo.Wire.V1.SnapshotMessage" Alias="SnapshotMessage" />
    <Using Include="RpgMmo.Wire.V1.EntitySnapshot" Alias="EntitySnapshot" />
    <Using Include="RpgMmo.Wire.V1.EntityType" Alias="EntityType" />
    <Using Include="RpgMmo.Wire.V1.TransferMapRequest" Alias="TransferMapRequest" />
    <Using Include="RpgMmo.Wire.V1.TransferMapResponse" Alias="TransferMapResponse" />
    <Using Include="RpgMmo.Wire.V1.PingMessage" Alias="PingMessage" />
    <Using Include="RpgMmo.Wire.V1.PongMessage" Alias="PongMessage" />
    <Using Include="RpgMmo.Wire.V1.KickMessage" Alias="KickMessage" />
    <Using Include="RpgMmo.Wire.V1.DisconnectMessage" Alias="DisconnectMessage" />
  </ItemGroup>

</Project>
