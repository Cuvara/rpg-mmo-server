<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.11" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.17.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shared.GameLogic.Components" />
    <Using Include="Shared.GameLogic.Systems" />
    <Using Include="GameServer.Net" />
    <Using Include="GameServer.World" />
    <Using Include="GameServer.Server" />
    <Using Include="GameServer.Input" />
    <Using Include="GameServer.Persistence" />
    <Using Include="GameServer.Events" />
    <Using Include="GameServer.Agones" />
    <Using Include="GameServer.Snapshot" />
    <Using Include="GameServer.Observability" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.GameLogic\Shared.GameLogic.csproj" />
    <ProjectReference Include="..\GameServer\GameServer.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- The generated wire.proto types ARE the game server's message types.
         Imported as explicit aliases rather than a whole-namespace using so that
         RpgMmo.Wire.V1.Envelope (the protobuf message) never collides with
         GameServer.Net.Envelope (the framing envelope that carries encoding
         metadata) - they are different things with the same name. -->
    <Using Include="RpgMmo.Wire.V1.MsgType" Alias="MsgType" />
    <Using Include="RpgMmo.Wire.V1.JoinTokenRequest" Alias="JoinTokenRequest" />
    <Using Include="RpgMmo.Wire.V1.JoinTokenResponse" Alias="JoinTokenResponse" />
    <Using Include="RpgMmo.Wire.V1.InputMessage" Alias="InputMessage" />
    <Using Include="RpgMmo.Wire.V1.SnapshotMessage" Alias="SnapshotMessage" />
    <Using Include="RpgMmo.Wire.V1.EntitySnapshot" Alias="EntitySnapshot" />
    <Using Include="RpgMmo.Wire.V1.EntityType" Alias="EntityType" />
    <Using Include="RpgMmo.Wire.V1.TransferMapRequest" Alias="TransferMapRequest" />
    <Using Include="RpgMmo.Wire.V1.TransferMapResponse" Alias="TransferMapResponse" />
    <Using Include="RpgMmo.Wire.V1.PingMessage" Alias="PingMessage" />
    <Using Include="RpgMmo.Wire.V1.PongMessage" Alias="PongMessage" />
    <Using Include="RpgMmo.Wire.V1.KickMessage" Alias="KickMessage" />
    <Using Include="RpgMmo.Wire.V1.DisconnectMessage" Alias="DisconnectMessage" />
  </ItemGroup>

</Project>
