    <Using Include="GameServer.Net" />
    <Using Include="GameServer.World" />
    <Using Include="GameServer.Server" />
    <Using Include="GameServer.Input" />
    <Using Include="GameServer.Persistence" />
    <Using Include="GameServer.Events" />
    <Using Include="GameServer.Agones" />
