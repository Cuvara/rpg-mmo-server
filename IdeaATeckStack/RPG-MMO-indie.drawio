        </mxCell>
        <mxCell id="status-banner-0" value="✅ ĐÚNG THỰC TẾ — nhưng JWT verify là local bằng keyring, không gọi Nakama; Nakama chỉ mint token qua RPC gateway_token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
