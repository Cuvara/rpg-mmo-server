        </mxCell>
        <mxCell id="p1-13" value="11. UDP/KCP Connect + Session Token" style="endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="625" as="sourcePoint" /><mxPoint x="1085" y="625" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-38" value="JWT verify LOCAL — shared secret, không gọi Nakama" style="text;align=left;fontSize=10;fontStyle=2;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1095" y="635" width="300" height="20" as="geometry" />
        </mxCell>
