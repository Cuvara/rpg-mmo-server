        </mxCell>
        <mxCell id="p0-36" value="📊 Deployment (VPS + k3s)&#xa;&#xa;Tier 1 — Dev ($40-60/mo)&#xa;  • 1 VPS 4vCPU/8GB&#xa;  • k3s + Agones + all services&#xa;  • &lt; 200 CCU&#xa;&#xa;Tier 2 — Beta ($80-150/mo)&#xa;  • 2 VPS (app + DB)&#xa;  • + CDN cho assets&#xa;  • 200-500 CCU&#xa;&#xa;Tier 3 — Launch ($200-400/mo)&#xa;  • 3 VPS (Nakama, Gateway, DB)&#xa;  • Redis dedicated&#xa;  • 500-2,000 CCU&#xa;&#xa;Tier 4 — Growth ($400-1000/mo)&#xa;  • Multi-node k3s cluster&#xa;  • Managed DB (optional)&#xa;  • 2,000-5,000+ CCU&#xa;&#xa;✅ Nakama, k3s, Agones, Redis = $0 license&#xa;💰 Chi phí = VPS + bandwidth + CDN" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="1280" y="30" width="320" height="540" as="geometry" />
        </mxCell>
        <mxCell id="p0-37" value="Indie Optimizations:&#xa;• JWT verify local tại Gateway (shared secret)&#xa;• Redis Streams thay Pub/Sub cho event quan trọng&#xa;• Game server = C# .NET 10 NativeAOT binary (~50MB RAM/pod)&#xa;• k3s thay K8s full (~500MB vs 2GB+ control plane)&#xa;• PostgreSQL: 2 instance (meta + game state)&#xa;• Rate limiting tại Gateway + Nakama RPC" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1280" y="590" width="320" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Auth + Session" id="auth-session">
    <mxGraphModel pageWidth="1400" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-30" value="loop  [mỗi N giây]" style="shape=umlFrame;whiteSpace=wrap;width=140;height=26;fillColor=none;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="920" width="1320" height="100" as="geometry" />
        </mxCell>
