          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="170" as="sourcePoint" /><mxPoint x="365" y="170" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-3" value="2. Validate credentials" style="endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
