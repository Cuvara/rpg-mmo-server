          <mxGeometry relative="1" as="geometry"><mxPoint x="845" y="290" as="sourcePoint" /><mxPoint x="605" y="290" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-6" value="5. Auth OK" style="endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="605" y="330" as="sourcePoint" /><mxPoint x="365" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-7" value="6. Session Token (JWT) + Refresh Token" style="endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="365" y="370" as="sourcePoint" /><mxPoint x="125" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
