        </mxCell>
        <mxCell id="p1-35" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="845" y="80" as="sourcePoint" /><mxPoint x="845" y="1240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-36" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1085" y="80" as="sourcePoint" /><mxPoint x="1085" y="1240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-37" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1265" y="80" as="sourcePoint" /><mxPoint x="1265" y="1240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-1" value="Phase 1 — Login (HTTPS)" style="whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="35" y="115" width="1290" height="30" as="geometry" />
        </mxCell>
