        </mxCell>
        <mxCell id="p9-31" value="Tech Stack — tất cả open-source" style="rounded=1;whiteSpace=wrap;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=5;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="750" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p9-32" value="Game Backend:     Nakama (Go) — Apache 2.0&#xa;Game Servers:     C# .NET 10 NativeAOT — self-owned&#xa;Orchestration:    k3s + Agones — Apache 2.0&#xa;Database:         PostgreSQL — free&#xa;Cache / PubSub:   Redis — BSD&#xa;Client Engine:    Unity 2022 LTS+&#xa;Client ECS:       Unity DOTS&#xa;Realtime:         KCP/UDP (custom Gateway)&#xa;Serialization:    Protobuf / FlatBuffers&#xa;CDN:              CloudFlare R2 / BunnyCDN&#xa;Monitoring:       Grafana Cloud free tier&#xa;CI/CD:            GitHub Actions free tier&#xa;Crash Report:     Sentry / Firebase free tier&#xa;Auth:             Nakama built-in (device → email → social)" style="text;fontSize=11;fontColor=#333333;align=left;spacingLeft=15;spacingTop=10;whiteSpace=wrap;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="700" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p9-33" value="Monitoring Stack" style="rounded=1;whiteSpace=wrap;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=5;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="490" width="720" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p9-34" value="Nakama Console        — built-in admin UI&#xa;Grafana Cloud          — CCU, match count, RPC latency&#xa;Prometheus export      — Nakama + game server metrics&#xa;Sentry / Crashlytics   — client crash reports&#xa;pg_stat_statements     — query performance&#xa;Redis INFO + MONITOR   — cache hit rate, memory&#xa;Uptime Robot           — external health check&#xa;k3s kubectl top        — pod resource usage&#xa;&#xa;Alerting:&#xa;  • Error rate &gt; threshold → Slack/Discord&#xa;  • High latency → auto-scale pods&#xa;  • Disk &gt; 80% → alert&#xa;  • Game server crash → auto-restart (k3s)" style="text;fontSize=11;fontColor=#333333;align=left;spacingLeft=15;spacingTop=10;whiteSpace=wrap;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="850" y="530" width="680" height="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="11. Content Pipeline (ADR-19)" id="content-pipeline">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="cp0" />
        <mxCell id="cp1" parent="cp0" />
        <mxCell id="cp-banner" value="✅ ĐÃ LÀM 2026-08-22 (ADR-19) — content là file JSON trên server, phục vụ qua HTTP. Sửa content = restart server, KHÔNG rebuild client, KHÔNG cắt tag, KHÔNG bump lock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="cp1">
          <mxGeometry x="40" y="16" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cp-why" value="VÌ SAO: kênh duy nhất giữa hai repo là Shared.GameLogic — package ghim theo commit chính xác.&#10;Đổi một con số cân bằng = commit + cắt tag sgl-v + bump CẢ manifest.json lẫn packages-lock.json.&#10;Đúng cho luật simulation (đổi hàng tháng, phải đổi cả hai bên cùng lúc nếu không prediction lệch).&#10;Chết cho content (đổi hàng giờ, giá trị nằm ở tốc độ lặp)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="cp1">
          <mxGeometry x="40" y="80" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cp-files" value="backend/content/items.json&#10;(nguồn sự thật — designer sửa file này)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="cp1">
          <mxGeometry x="80" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cp-boot" value="Game server — lúc BOOT&#10;load → validate → hash&#10;SAI thì TỪ CHỐI KHỞI ĐỘNG,&#10;in mọi lỗi trong một lần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="cp1">
          <mxGeometry x="430" y="240" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cp-http" value="GET /content&#10;cạnh /metrics · /healthz · /status&#10;KHÔNG cổng mới, KHÔNG message wire mới" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="cp1">
          <mxGeometry x="780" y="240" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cp-client" value="Unity client — ContentClient&#10;(com.cuvara.netcode / Runtime/Content)&#10;fetch → parse → validate → cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="cp1">
          <mxGeometry x="1150" y="240" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cp-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="cp1" source="cp-files" target="cp-boot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="cp1" source="cp-boot" target="cp-http">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-e3" value="?hash= → 304 nếu không đổi" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="cp1" source="cp-http" target="cp-client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-cache" value="CACHE THEO HASH, KHÔNG theo thời gian&#10;&#10;Content không hết hạn — nó đổi khi server restart với file khác, và hash là cách phát hiện.&#10;Cache theo TTL sẽ hoặc tải lại thứ không đổi, hoặc phục vụ thứ đã đổi.&#10;&#10;Hash trả về ở CẢ ETag lẫn X-Content-Hash: UnityWebRequest và vài proxy viết đè/xoá ETag,&#10;mà client không đọc lại được hash thì không bao giờ gửi được ?hash= — im lặng tải full mỗi lần mở." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="cp1">
          <mxGeometry x="80" y="400" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cp-schema" value="SCHEMA dùng chung, PARSER thì không&#10;&#10;Shared.GameLogic/Content/ giữ kiểu dữ liệu + validator, compile vào cả hai bên.&#10;Parser mỗi bên một kiểu — BẮT BUỘC, không phải lựa chọn:&#10;  • Unity compile Shared.GameLogic dạng SOURCE và không có System.Text.Json&#10;  • Server chạy NativeAOT, không dùng được reflection&#10;Không parser nào thoả cả hai. Golden vectors bù vào chỗ đó, như ADR-10 đã làm cho wire." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="cp1">
          <mxGeometry x="880" y="400" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cp-limits" value="GIỚI HẠN CÓ CHỦ Ý&#10;&#10;• KHÔNG hot reload. ContentDatabase bất biến suốt đời tiến trình — luật đổi dưới chân một simulation đang chạy làm mọi desync không tái hiện được.&#10;• Client validate thứ nó tải về, và điều đó KHÔNG cho client thêm quyền gì: nó trả lời &quot;content này có nhất quán không&quot;, không bao giờ trả lời &quot;player này có được cầm món đồ này không&quot;. Server vẫn quyết định mọi thứ.&#10;• Sample scene ContentPipeline có fallback offline — đó là tiện ích của scene, KHÔNG phải mẫu để làm theo: content client tự bịa là content server chưa từng validate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="cp1">
          <mxGeometry x="80" y="600" width="1520" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
