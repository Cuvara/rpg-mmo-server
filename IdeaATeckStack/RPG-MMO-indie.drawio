        </mxCell>
        <mxCell id="p1-16" value="14. Realtime channel established (UDP)" style="endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1085" y="755" as="sourcePoint" /><mxPoint x="125" y="755" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-17" value="Phase 3 — Heartbeat + reconnect" style="whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="35" y="870" width="1290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-18" value="15. Heartbeat (KCP ping)" style="endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="960" as="sourcePoint" /><mxPoint x="1085" y="960" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-19" value="16. Refresh session TTL" style="endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1085" y="990" as="sourcePoint" /><mxPoint x="1265" y="990" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="p1-20" value="17. Refresh token (HTTPS)" style="endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
